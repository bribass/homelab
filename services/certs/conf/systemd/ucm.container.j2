[Unit]
Description=Ultimate Certificate Manager

[Container]
Image=docker.io/neyslim/ultimate-ca-manager:{{ ucm.version }}
Network=systemd.network
PublishPort=8443:8443
PublishPort=8080:8080
Volume=/opt/ucm/data:/opt/ucm/data
Volume=/opt/ucm/etc:/etc/ucm
EnvironmentFile=ucm.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
